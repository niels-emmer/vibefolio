# ============================================================================
# vibefolio configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================================

# --- Required ---
# Password for the /admin panel. Use a long, random value.
# In production the app refuses to start if this is a placeholder/dev value.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- Optional (defaults shown) ---
# Port the app listens on inside the container.
PORT=3000

# How often (seconds) to re-check service health. Default 60.
HEALTH_CHECK_INTERVAL=60

# Per-request timeout (ms) for a health check. Default 5000.
HEALTH_CHECK_TIMEOUT=5000

# Allow health checks to reach private/loopback addresses (e.g. LAN services).
# Default 0 (secure). Set to 1 ONLY if you knowingly host services on private IPs.
HEALTH_ALLOW_PRIVATE=0

# Session lifetime in hours. Default 12.
SESSION_TTL_HOURS=12

# Max login attempts per IP per 15 minutes. Default 10.
LOGIN_RATE_LIMIT=10

# Comma-separated list of allowed origins for the admin API (CSRF origin check).
# In production behind nginx-proxy-manager, set this to your public origin,
# e.g. https://services.your-domain.example
ALLOWED_ORIGINS=

# Optional: the reverse-proxy IP to trust for X-Forwarded-For (rate limiting).
# Set to your nginx-proxy-manager container IP on the shared network so only
# that peer is trusted — otherwise any container on the same Docker network
# can spoof X-Forwarded-For and bypass the login rate limiter.
# Leave empty to trust the immediate peer (default).
TRUST_PROXY_IP=

# Optional: shared token for the browserless/chrome screenshot service
# (used to capture service thumbnails). Generate one, e.g.:
#   openssl rand -hex 24
# The app and the screenshot-service container must use the same value.
BROWSERLESS_TOKEN=

# Where that screenshot service lives. Defaults to the compose service name, so
# it only needs setting if you run the app outside the compose file.
# BROWSERLESS_URL=http://screenshot-service:3000

# Where the pre-restore snapshots are written (see docs/decisions.md D25).
# Defaults to a `backups` directory beside the database, which in production is
# the writable `services-data` volume — the container's root filesystem is
# read-only, so anywhere else fails at the worst possible moment (mid-restore).
# BACKUP_DIR=/app/data/backups

# --- Feedback form ---
# Off by default; the toggle and SMTP credentials live in the admin panel's
# Feedback block, not here (see src/mailer.js — they are deliberately outside
# SETTING_KEYS so they can never reach /api/site).

# Signing key for the form's timing token. Not a credential — it only needs to be
# unguessable per deployment — so an unset value is generated at boot. Set it to
# keep tokens valid across restarts, and across instances if you ever run more
# than one. Generate with: openssl rand -hex 32
# FEEDBACK_TOKEN_SECRET=

# How long a visitor may take to fill the form in, in minutes. Default 60.
# FEEDBACK_TOKEN_TTL_MINUTES=60

# Minimum seconds between page load and submit. Beats bots that post instantly and
# costs a human nothing. Default 3.
# FEEDBACK_MIN_SECONDS=3

# Submissions allowed per IP per window (15 minutes). Default 5.
# FEEDBACK_RATE_LIMIT=5

# --- Misc ---

# Explicitly 'production' in the container (set by docker-compose.yml, not by this
# file). It enables secure cookies, gates HSTS to TLS-serving deployments, and
# makes a placeholder ADMIN_PASSWORD a boot error.
# NODE_ENV=production

# Opt in to Strict-Transport-Security when NODE_ENV is not production. Only
# meaningful over TLS — sending HSTS from a plain-HTTP origin makes the browser
# upgrade every later subresource to https and the page renders unstyled. See
# docs/DEVELOPMENT.md before setting this.
# HSTS_ENABLED=0
